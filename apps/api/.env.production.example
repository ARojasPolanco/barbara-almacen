# API - producción
# Copiar como .env.production o cargar estas variables en el panel del proveedor.
# No commitear valores reales.

PORT=3000
NODE_ENV=production

# Neon/Render: incluir sslmode=require
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/REPLACE_DB?sslmode=require

# Generar uno nuevo; nunca reutilizar el de desarrollo.
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHARS

VENDOR_PASSWORD=REPLACE_WITH_VENDOR_PASSWORD
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# Dominio real de la web, sin barra final.
ALLOWED_ORIGIN=https://REPLACE_WEB_DOMAIN
