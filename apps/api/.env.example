# Servidor
PORT=3000
NODE_ENV=development

# Base de datos local (Docker expone PostgreSQL en 5433)
DATABASE_URL=postgresql://pricetracker:pricetracker_dev_password@localhost:5433/pricetracker_dev

# Producción (Neon/Render): usar la connection string con SSL
# DATABASE_URL=postgresql://usuario:password@host/base?sslmode=require

# Autenticación
JWT_SECRET=change_this_to_a_random_string
VENDOR_PASSWORD=
ADMIN_PASSWORD=

# Origen permitido por CORS en producción
ALLOWED_ORIGIN=http://localhost:5173

# Logs SQL de Sequelize (false por defecto)
# DB_LOGGING=true
